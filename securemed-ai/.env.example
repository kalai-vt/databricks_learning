# SecureMed AI - Environment Configuration Example
# Copy this file to backend/.env and fill in real values for local use.
# NEVER commit the real .env file to Git.

# --- LLM Provider ---
# Provider abstraction: only "openai" is implemented today, but the
# architecture supports adding anthropic / gemini / local later without
# touching governance, RBAC, tenant isolation or audit logging.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If no OPENAI_API_KEY is set, or MOCK_LLM=true, the app runs in
# deterministic Mock/Demo LLM mode so the presentation never fails.
MOCK_LLM=true

# --- Security ---
JWT_SECRET=change-this-demo-secret-in-any-real-deployment
JWT_EXPIRES_MINUTES=480

# --- Database ---
DATABASE_URL=sqlite:///./securemed.db

# --- App ---
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
